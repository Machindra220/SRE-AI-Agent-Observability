{
  "__inputs": [
    {
      "name": "DS_GRAFANA_CLOUD_PROMETHEUS",
      "label": "Grafana Cloud Prometheus",
      "description": "Grafana Cloud Mimir datasource (scarletcanary2090)",
      "type": "datasource",
      "pluginId": "prometheus",
      "pluginName": "Prometheus"
    },
    {
      "name": "DS_GRAFANA_CLOUD_LOKI",
      "label": "Grafana Cloud Loki",
      "description": "Grafana Cloud Loki datasource (scarletcanary2090)",
      "type": "datasource",
      "pluginId": "loki",
      "pluginName": "Loki"
    }
  ],
  "__requires": [
    { "type": "grafana", "id": "grafana", "name": "Grafana", "version": "10.0.0" },
    { "type": "datasource", "id": "prometheus", "name": "Prometheus", "version": "1.0.0" },
    { "type": "datasource", "id": "loki", "name": "Loki", "version": "1.0.0" },
    { "type": "panel", "id": "timeseries", "name": "Time series", "version": "" },
    { "type": "panel", "id": "stat", "name": "Stat", "version": "" },
    { "type": "panel", "id": "logs", "name": "Logs", "version": "" },
    { "type": "panel", "id": "gauge", "name": "Gauge", "version": "" },
    { "type": "panel", "id": "table", "name": "Table", "version": "" }
  ],
  "annotations": {
    "list": [
      {
        "builtIn": 1,
        "datasource": { "type": "grafana", "uid": "-- Grafana --" },
        "enable": true,
        "hide": true,
        "iconColor": "rgba(0, 211, 255, 1)",
        "name": "Annotations & Alerts",
        "type": "dashboard"
      },
      {
        "datasource": { "type": "prometheus", "uid": "${DS_GRAFANA_CLOUD_PROMETHEUS}" },
        "enable": true,
        "expr": "changes(kube_pod_container_restarts_total{namespace=\"sre-ai-agent\"}[2m]) > 0",
        "hide": false,
        "iconColor": "red",
        "name": "Pod Killed by chaoskube",
        "step": "60s",
        "titleFormat": "🔴 Chaos: Pod Killed",
        "type": "prometheus"
      }
    ]
  },
  "description": "Phase 24 — Real-time chaos monitoring: chaoskube kills → Grafana Cloud alerts → LangGraph RCA",
  "editable": true,
  "fiscalYearStartMonth": 0,
  "graphTooltip": 1,
  "id": null,
  "links": [],
  "panels": [
    {
      "collapsed": false,
      "gridPos": { "h": 1, "w": 24, "x": 0, "y": 0 },
      "id": 100,
      "title": "🔴 Chaos Status",
      "type": "row"
    },
    {
      "datasource": { "type": "prometheus", "uid": "${DS_GRAFANA_CLOUD_PROMETHEUS}" },
      "fieldConfig": {
        "defaults": {
          "color": { "mode": "thresholds" },
          "mappings": [
            { "options": { "0": { "color": "green", "index": 0, "text": "Stable" } }, "type": "value" }
          ],
          "thresholds": {
            "mode": "absolute",
            "steps": [
              { "color": "green", "value": null },
              { "color": "yellow", "value": 1 },
              { "color": "red", "value": 3 }
            ]
          },
          "unit": "short"
        }
      },
      "gridPos": { "h": 4, "w": 4, "x": 0, "y": 1 },
      "id": 1,
      "options": {
        "colorMode": "background",
        "graphMode": "none",
        "justifyMode": "center",
        "orientation": "auto",
        "reduceOptions": { "calcs": ["lastNotNull"], "fields": "", "values": false },
        "textMode": "auto"
      },
      "title": "Pod Restarts (last 5m)",
      "type": "stat",
      "targets": [
        {
          "datasource": { "type": "prometheus", "uid": "${DS_GRAFANA_CLOUD_PROMETHEUS}" },
          "expr": "sum(increase(kube_pod_container_restarts_total{namespace=\"sre-ai-agent\"}[5m]))",
          "legendFormat": "Restarts",
          "refId": "A"
        }
      ]
    },
    {
      "datasource": { "type": "prometheus", "uid": "${DS_GRAFANA_CLOUD_PROMETHEUS}" },
      "fieldConfig": {
        "defaults": {
          "color": { "mode": "thresholds" },
          "thresholds": {
            "mode": "absolute",
            "steps": [
              { "color": "green", "value": null },
              { "color": "red", "value": 1 }
            ]
          },
          "unit": "percentunit",
          "min": 0,
          "max": 1
        }
      },
      "gridPos": { "h": 4, "w": 4, "x": 4, "y": 1 },
      "id": 2,
      "options": {
        "colorMode": "background",
        "graphMode": "none",
        "justifyMode": "center",
        "orientation": "auto",
        "reduceOptions": { "calcs": ["lastNotNull"], "fields": "", "values": false },
        "textMode": "auto"
      },
      "title": "HTTP Error Rate",
      "type": "stat",
      "targets": [
        {
          "datasource": { "type": "prometheus", "uid": "${DS_GRAFANA_CLOUD_PROMETHEUS}" },
          "expr": "sum(rate(http_requests_total{namespace=\"sre-ai-agent\", status=~\"5..\"}[2m])) / sum(rate(http_requests_total{namespace=\"sre-ai-agent\"}[2m]))",
          "legendFormat": "Error Rate",
          "refId": "A"
        }
      ]
    },
    {
      "datasource": { "type": "prometheus", "uid": "${DS_GRAFANA_CLOUD_PROMETHEUS}" },
      "fieldConfig": {
        "defaults": {
          "color": { "mode": "thresholds" },
          "thresholds": {
            "mode": "absolute",
            "steps": [
              { "color": "green", "value": null },
              { "color": "yellow", "value": 0.5 },
              { "color": "red", "value": 1 }
            ]
          },
          "unit": "s"
        }
      },
      "gridPos": { "h": 4, "w": 4, "x": 8, "y": 1 },
      "id": 3,
      "options": {
        "colorMode": "background",
        "graphMode": "none",
        "justifyMode": "center",
        "orientation": "auto",
        "reduceOptions": { "calcs": ["lastNotNull"], "fields": "", "values": false },
        "textMode": "auto"
      },
      "title": "p99 Latency",
      "type": "stat",
      "targets": [
        {
          "datasource": { "type": "prometheus", "uid": "${DS_GRAFANA_CLOUD_PROMETHEUS}" },
          "expr": "histogram_quantile(0.99, sum(rate(http_request_duration_seconds_bucket{namespace=\"sre-ai-agent\"}[2m])) by (le))",
          "legendFormat": "p99",
          "refId": "A"
        }
      ]
    },
    {
      "datasource": { "type": "prometheus", "uid": "${DS_GRAFANA_CLOUD_PROMETHEUS}" },
      "fieldConfig": {
        "defaults": {
          "color": { "mode": "thresholds" },
          "thresholds": {
            "mode": "absolute",
            "steps": [
              { "color": "green", "value": null },
              { "color": "yellow", "value": 1 },
              { "color": "red", "value": 2 }
            ]
          },
          "unit": "short"
        }
      },
      "gridPos": { "h": 4, "w": 4, "x": 12, "y": 1 },
      "id": 4,
      "options": {
        "colorMode": "background",
        "graphMode": "none",
        "justifyMode": "center",
        "orientation": "auto",
        "reduceOptions": { "calcs": ["lastNotNull"], "fields": "", "values": false },
        "textMode": "auto"
      },
      "title": "Pods Not Running",
      "type": "stat",
      "targets": [
        {
          "datasource": { "type": "prometheus", "uid": "${DS_GRAFANA_CLOUD_PROMETHEUS}" },
          "expr": "count(kube_pod_status_phase{namespace=\"sre-ai-agent\", phase!=\"Running\"}) or vector(0)",
          "legendFormat": "Not Running",
          "refId": "A"
        }
      ]
    },
    {
      "datasource": { "type": "prometheus", "uid": "${DS_GRAFANA_CLOUD_PROMETHEUS}" },
      "fieldConfig": {
        "defaults": {
          "color": { "mode": "thresholds" },
          "thresholds": {
            "mode": "absolute",
            "steps": [
              { "color": "red", "value": null },
              { "color": "green", "value": 1 }
            ]
          },
          "unit": "short"
        }
      },
      "gridPos": { "h": 4, "w": 4, "x": 16, "y": 1 },
      "id": 5,
      "options": {
        "colorMode": "background",
        "graphMode": "none",
        "justifyMode": "center",
        "orientation": "auto",
        "reduceOptions": { "calcs": ["lastNotNull"], "fields": "", "values": false },
        "textMode": "auto"
      },
      "title": "Running Pods (sre-ai-agent)",
      "type": "stat",
      "targets": [
        {
          "datasource": { "type": "prometheus", "uid": "${DS_GRAFANA_CLOUD_PROMETHEUS}" },
          "expr": "count(kube_pod_status_phase{namespace=\"sre-ai-agent\", phase=\"Running\"})",
          "legendFormat": "Running",
          "refId": "A"
        }
      ]
    },
    {
      "datasource": { "type": "prometheus", "uid": "${DS_GRAFANA_CLOUD_PROMETHEUS}" },
      "fieldConfig": {
        "defaults": {
          "color": { "mode": "thresholds" },
          "thresholds": {
            "mode": "absolute",
            "steps": [
              { "color": "green", "value": null },
              { "color": "yellow", "value": 30 },
              { "color": "red", "value": 60 }
            ]
          },
          "unit": "s"
        }
      },
      "gridPos": { "h": 4, "w": 4, "x": 20, "y": 1 },
      "id": 6,
      "options": {
        "colorMode": "background",
        "graphMode": "none",
        "justifyMode": "center",
        "orientation": "auto",
        "reduceOptions": { "calcs": ["lastNotNull"], "fields": "", "values": false },
        "textMode": "auto"
      },
      "title": "Pod Recovery Time (est.)",
      "type": "stat",
      "targets": [
        {
          "datasource": { "type": "prometheus", "uid": "${DS_GRAFANA_CLOUD_PROMETHEUS}" },
          "expr": "avg(kube_pod_status_ready_time{namespace=\"sre-ai-agent\"}) - avg(kube_pod_created{namespace=\"sre-ai-agent\"})",
          "legendFormat": "Recovery s",
          "refId": "A"
        }
      ]
    },
    {
      "collapsed": false,
      "gridPos": { "h": 1, "w": 24, "x": 0, "y": 5 },
      "id": 101,
      "title": "📈 Chaos Impact — Real-time Metrics",
      "type": "row"
    },
    {
      "datasource": { "type": "prometheus", "uid": "${DS_GRAFANA_CLOUD_PROMETHEUS}" },
      "fieldConfig": {
        "defaults": {
          "color": { "mode": "palette-classic" },
          "custom": {
            "axisCenteredZero": false,
            "axisColorMode": "text",
            "axisLabel": "Restarts/min",
            "axisPlacement": "auto",
            "barAlignment": 0,
            "drawStyle": "line",
            "fillOpacity": 20,
            "gradientMode": "none",
            "lineInterpolation": "smooth",
            "lineWidth": 2,
            "pointSize": 5,
            "scaleDistribution": { "type": "linear" },
            "showPoints": "auto",
            "spanNulls": false,
            "stacking": { "group": "A", "mode": "none" },
            "thresholdsStyle": { "mode": "off" }
          },
          "unit": "short"
        },
        "overrides": [
          {
            "matcher": { "id": "byName", "options": "Pod Restarts" },
            "properties": [
              { "id": "color", "value": { "fixedColor": "red", "mode": "fixed" } }
            ]
          }
        ]
      },
      "gridPos": { "h": 8, "w": 12, "x": 0, "y": 6 },
      "id": 10,
      "options": {
        "legend": { "calcs": ["max", "lastNotNull"], "displayMode": "table", "placement": "bottom" },
        "tooltip": { "mode": "multi", "sort": "desc" }
      },
      "title": "Pod Restarts — Chaos Kill Rate",
      "description": "Spikes = chaoskube killing pods. Should return to 0 after recovery.",
      "type": "timeseries",
      "targets": [
        {
          "datasource": { "type": "prometheus", "uid": "${DS_GRAFANA_CLOUD_PROMETHEUS}" },
          "expr": "sum(rate(kube_pod_container_restarts_total{namespace=\"sre-ai-agent\"}[2m])) * 60",
          "legendFormat": "Pod Restarts",
          "refId": "A"
        },
        {
          "datasource": { "type": "prometheus", "uid": "${DS_GRAFANA_CLOUD_PROMETHEUS}" },
          "expr": "sum(rate(kube_pod_container_restarts_total{namespace=\"sre-ai-agent-llm\"}[2m])) * 60",
          "legendFormat": "Agent Restarts",
          "refId": "B"
        }
      ]
    },
    {
      "datasource": { "type": "prometheus", "uid": "${DS_GRAFANA_CLOUD_PROMETHEUS}" },
      "fieldConfig": {
        "defaults": {
          "color": { "mode": "palette-classic" },
          "custom": {
            "drawStyle": "line",
            "fillOpacity": 20,
            "lineInterpolation": "smooth",
            "lineWidth": 2,
            "pointSize": 5,
            "spanNulls": false
          },
          "unit": "percentunit",
          "min": 0,
          "max": 1
        },
        "overrides": [
          {
            "matcher": { "id": "byName", "options": "Error Rate (5xx)" },
            "properties": [
              { "id": "color", "value": { "fixedColor": "red", "mode": "fixed" } }
            ]
          }
        ]
      },
      "gridPos": { "h": 8, "w": 12, "x": 12, "y": 6 },
      "id": 11,
      "options": {
        "legend": { "calcs": ["max", "lastNotNull"], "displayMode": "table", "placement": "bottom" },
        "tooltip": { "mode": "multi", "sort": "desc" }
      },
      "title": "HTTP Error Rate During Chaos",
      "description": "Error rate rises when chaoskube kills the active pod. Watch recovery.",
      "type": "timeseries",
      "targets": [
        {
          "datasource": { "type": "prometheus", "uid": "${DS_GRAFANA_CLOUD_PROMETHEUS}" },
          "expr": "sum(rate(http_requests_total{namespace=\"sre-ai-agent\", status=~\"5..\"}[2m])) / sum(rate(http_requests_total{namespace=\"sre-ai-agent\"}[2m]))",
          "legendFormat": "Error Rate (5xx)",
          "refId": "A"
        },
        {
          "datasource": { "type": "prometheus", "uid": "${DS_GRAFANA_CLOUD_PROMETHEUS}" },
          "expr": "sum(rate(http_requests_total{namespace=\"sre-ai-agent\", status=~\"2..\"}[2m])) / sum(rate(http_requests_total{namespace=\"sre-ai-agent\"}[2m]))",
          "legendFormat": "Success Rate (2xx)",
          "refId": "B"
        }
      ]
    },
    {
      "datasource": { "type": "prometheus", "uid": "${DS_GRAFANA_CLOUD_PROMETHEUS}" },
      "fieldConfig": {
        "defaults": {
          "color": { "mode": "palette-classic" },
          "custom": {
            "drawStyle": "line",
            "fillOpacity": 10,
            "lineInterpolation": "smooth",
            "lineWidth": 2,
            "spanNulls": false
          },
          "unit": "s"
        }
      },
      "gridPos": { "h": 8, "w": 12, "x": 0, "y": 14 },
      "id": 12,
      "options": {
        "legend": { "calcs": ["max", "mean", "lastNotNull"], "displayMode": "table", "placement": "bottom" },
        "tooltip": { "mode": "multi", "sort": "desc" }
      },
      "title": "Latency Percentiles During Chaos",
      "description": "p99 spikes during pod kill. Recovery visible when latency normalizes.",
      "type": "timeseries",
      "targets": [
        {
          "datasource": { "type": "prometheus", "uid": "${DS_GRAFANA_CLOUD_PROMETHEUS}" },
          "expr": "histogram_quantile(0.99, sum(rate(http_request_duration_seconds_bucket{namespace=\"sre-ai-agent\"}[2m])) by (le))",
          "legendFormat": "p99 latency",
          "refId": "A"
        },
        {
          "datasource": { "type": "prometheus", "uid": "${DS_GRAFANA_CLOUD_PROMETHEUS}" },
          "expr": "histogram_quantile(0.95, sum(rate(http_request_duration_seconds_bucket{namespace=\"sre-ai-agent\"}[2m])) by (le))",
          "legendFormat": "p95 latency",
          "refId": "B"
        },
        {
          "datasource": { "type": "prometheus", "uid": "${DS_GRAFANA_CLOUD_PROMETHEUS}" },
          "expr": "histogram_quantile(0.50, sum(rate(http_request_duration_seconds_bucket{namespace=\"sre-ai-agent\"}[2m])) by (le))",
          "legendFormat": "p50 latency",
          "refId": "C"
        }
      ]
    },
    {
      "datasource": { "type": "prometheus", "uid": "${DS_GRAFANA_CLOUD_PROMETHEUS}" },
      "fieldConfig": {
        "defaults": {
          "color": { "mode": "palette-classic" },
          "custom": {
            "drawStyle": "line",
            "fillOpacity": 15,
            "lineInterpolation": "smooth",
            "lineWidth": 2,
            "spanNulls": false
          },
          "unit": "short"
        }
      },
      "gridPos": { "h": 8, "w": 12, "x": 12, "y": 14 },
      "id": 13,
      "options": {
        "legend": { "calcs": ["lastNotNull"], "displayMode": "table", "placement": "bottom" },
        "tooltip": { "mode": "multi", "sort": "desc" }
      },
      "title": "Pod Count — Running vs Total",
      "description": "Running pod count dips to 0 during kill, then recovers. Recovery time visible.",
      "type": "timeseries",
      "targets": [
        {
          "datasource": { "type": "prometheus", "uid": "${DS_GRAFANA_CLOUD_PROMETHEUS}" },
          "expr": "count(kube_pod_status_phase{namespace=\"sre-ai-agent\", phase=\"Running\"})",
          "legendFormat": "Running",
          "refId": "A"
        },
        {
          "datasource": { "type": "prometheus", "uid": "${DS_GRAFANA_CLOUD_PROMETHEUS}" },
          "expr": "count(kube_pod_status_phase{namespace=\"sre-ai-agent\"})",
          "legendFormat": "Total",
          "refId": "B"
        }
      ]
    },
    {
      "collapsed": false,
      "gridPos": { "h": 1, "w": 24, "x": 0, "y": 22 },
      "id": 102,
      "title": "🤖 LangGraph RCA Agent — Triage Activity",
      "type": "row"
    },
    {
      "datasource": { "type": "loki", "uid": "${DS_GRAFANA_CLOUD_LOKI}" },
      "gridPos": { "h": 10, "w": 24, "x": 0, "y": 23 },
      "id": 20,
      "options": {
        "dedupStrategy": "none",
        "enableLogDetails": true,
        "prettifyLogMessage": false,
        "showCommonLabels": false,
        "showLabels": true,
        "showTime": true,
        "sortOrder": "Descending",
        "wrapLogMessage": true
      },
      "title": "LangGraph Agent — RCA Output Log",
      "description": "Shows alert_parser → runbook_retriever → diagnoser → rca_writer pipeline output. Appears ~30s after chaoskube kills a pod.",
      "type": "logs",
      "targets": [
        {
          "datasource": { "type": "loki", "uid": "${DS_GRAFANA_CLOUD_LOKI}" },
          "expr": "{namespace=\"sre-ai-agent-llm\"} |= \"rca\" or {namespace=\"sre-ai-agent-llm\"} |= \"triage\" or {namespace=\"sre-ai-agent-llm\"} |= \"alert\" or {namespace=\"sre-ai-agent-llm\"} |= \"diagnosis\"",
          "legendFormat": "",
          "refId": "A"
        }
      ]
    },
    {
      "collapsed": false,
      "gridPos": { "h": 1, "w": 24, "x": 0, "y": 33 },
      "id": 103,
      "title": "💥 Chaos Events — chaoskube Kill Log",
      "type": "row"
    },
    {
      "datasource": { "type": "loki", "uid": "${DS_GRAFANA_CLOUD_LOKI}" },
      "gridPos": { "h": 8, "w": 12, "x": 0, "y": 34 },
      "id": 21,
      "options": {
        "dedupStrategy": "none",
        "enableLogDetails": true,
        "prettifyLogMessage": true,
        "showCommonLabels": false,
        "showLabels": false,
        "showTime": true,
        "sortOrder": "Descending",
        "wrapLogMessage": false
      },
      "title": "chaoskube — Pod Kill Events",
      "description": "Every log line = one pod killed. Timestamp shows when chaos was injected.",
      "type": "logs",
      "targets": [
        {
          "datasource": { "type": "loki", "uid": "${DS_GRAFANA_CLOUD_LOKI}" },
          "expr": "{namespace=\"chaos\"}",
          "legendFormat": "",
          "refId": "A"
        }
      ]
    },
    {
      "datasource": { "type": "loki", "uid": "${DS_GRAFANA_CLOUD_LOKI}" },
      "gridPos": { "h": 8, "w": 12, "x": 12, "y": 34 },
      "id": 22,
      "options": {
        "dedupStrategy": "none",
        "enableLogDetails": true,
        "prettifyLogMessage": false,
        "showCommonLabels": false,
        "showLabels": true,
        "showTime": true,
        "sortOrder": "Descending",
        "wrapLogMessage": true
      },
      "title": "App Errors During Chaos",
      "description": "Error logs from sre-ai-agent pod during chaos injection.",
      "type": "logs",
      "targets": [
        {
          "datasource": { "type": "loki", "uid": "${DS_GRAFANA_CLOUD_LOKI}" },
          "expr": "{namespace=\"sre-ai-agent\"} |= \"ERROR\" or {namespace=\"sre-ai-agent\"} |= \"error\" or {namespace=\"sre-ai-agent\"} |= \"exception\"",
          "legendFormat": "",
          "refId": "A"
        }
      ]
    },
    {
      "collapsed": false,
      "gridPos": { "h": 1, "w": 24, "x": 0, "y": 42 },
      "id": 104,
      "title": "📊 AI Quality Metrics (from Phase 20 evals)",
      "type": "row"
    },
    {
      "datasource": { "type": "prometheus", "uid": "${DS_GRAFANA_CLOUD_PROMETHEUS}" },
      "fieldConfig": {
        "defaults": {
          "color": { "mode": "palette-classic" },
          "custom": {
            "drawStyle": "line",
            "fillOpacity": 10,
            "lineInterpolation": "smooth",
            "lineWidth": 2,
            "spanNulls": true
          },
          "unit": "percentunit",
          "min": 0,
          "max": 1
        }
      },
      "gridPos": { "h": 8, "w": 12, "x": 0, "y": 43 },
      "id": 30,
      "options": {
        "legend": { "calcs": ["lastNotNull", "mean"], "displayMode": "table", "placement": "bottom" },
        "tooltip": { "mode": "multi", "sort": "desc" }
      },
      "title": "LangGraph RCA Quality — Eval Scores",
      "description": "context_recall, answer_correctness, faithfulness from evals/metrics.prom. Should stay high even during chaos.",
      "type": "timeseries",
      "targets": [
        {
          "datasource": { "type": "prometheus", "uid": "${DS_GRAFANA_CLOUD_PROMETHEUS}" },
          "expr": "sre_agent_eval_context_recall",
          "legendFormat": "context_recall",
          "refId": "A"
        },
        {
          "datasource": { "type": "prometheus", "uid": "${DS_GRAFANA_CLOUD_PROMETHEUS}" },
          "expr": "sre_agent_eval_answer_correctness",
          "legendFormat": "answer_correctness",
          "refId": "B"
        },
        {
          "datasource": { "type": "prometheus", "uid": "${DS_GRAFANA_CLOUD_PROMETHEUS}" },
          "expr": "sre_agent_eval_faithfulness",
          "legendFormat": "faithfulness",
          "refId": "C"
        }
      ]
    },
    {
      "datasource": { "type": "prometheus", "uid": "${DS_GRAFANA_CLOUD_PROMETHEUS}" },
