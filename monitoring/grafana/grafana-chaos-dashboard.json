{
  "title": "SRE AI Agent — Chaos & RCA Dashboard",
  "description": "Monitors chaoskube pod kills, restart rates, alert webhook triggers, and LangGraph RCA pipeline",
  "tags": ["sre", "chaos", "rca", "langgraph"],
  "timezone": "browser",
  "schemaVersion": 38,
  "version": 1,
  "refresh": "30s",
  "time": { "from": "now-1h", "to": "now" },
  "panels": [
    {
      "id": 1,
      "type": "stat",
      "title": "Pod Restarts (Last 5m)",
      "description": "Total pod restart count across sre-ai-agent namespace in the last 5 minutes",
      "datasource": {},
      "gridPos": { "x": 0, "y": 0, "w": 6, "h": 4 },
      "options": {
        "reduceOptions": { "calcs": ["lastNotNull"] },
        "colorMode": "background",
        "graphMode": "none",
        "textMode": "auto"
      },
      "fieldConfig": {
        "defaults": {
          "thresholds": {
            "mode": "absolute",
            "steps": [
              { "color": "green", "value": null },
              { "color": "yellow", "value": 1 },
              { "color": "red", "value": 3 }
            ]
          },
          "mappings": [],
          "unit": "short"
        }
      },
      "targets": [
        {
          "expr": "sum(increase(kube_pod_container_restarts_total{namespace=\"sre-ai-agent\"}[5m]))",
          "legendFormat": "Restarts",
          "refId": "A"
        }
      ]
    },
    {
      "id": 2,
      "type": "stat",
      "title": "Running Pods (sre-ai-agent)",
      "description": "Number of Running pods in the sre-ai-agent namespace",
      "datasource": {},
      "gridPos": { "x": 6, "y": 0, "w": 6, "h": 4 },
      "options": {
        "reduceOptions": { "calcs": ["lastNotNull"] },
        "colorMode": "background",
        "graphMode": "none",
        "textMode": "auto"
      },
      "fieldConfig": {
        "defaults": {
          "thresholds": {
            "mode": "absolute",
            "steps": [
              { "color": "red", "value": null },
              { "color": "yellow", "value": 1 },
              { "color": "green", "value": 2 }
            ]
          },
          "mappings": [],
          "unit": "short"
        }
      },
      "targets": [
        {
          "expr": "count(kube_pod_status_phase{namespace=\"sre-ai-agent\", phase=\"Running\"})",
          "legendFormat": "Running",
          "refId": "A"
        }
      ]
    },
    {
      "id": 3,
      "type": "stat",
      "title": "Agent Pod Status",
      "description": "sre-ai-agent-llm pod running count",
      "datasource": {},
      "gridPos": { "x": 12, "y": 0, "w": 6, "h": 4 },
      "options": {
        "reduceOptions": { "calcs": ["lastNotNull"] },
        "colorMode": "background",
        "graphMode": "none",
        "textMode": "auto"
      },
      "fieldConfig": {
        "defaults": {
          "thresholds": {
            "mode": "absolute",
            "steps": [
              { "color": "red", "value": null },
              { "color": "green", "value": 1 }
            ]
          },
          "mappings": [],
          "unit": "short"
        }
      },
      "targets": [
        {
          "expr": "count(kube_pod_status_phase{namespace=\"sre-ai-agent-llm\", phase=\"Running\"})",
          "legendFormat": "Running",
          "refId": "A"
        }
      ]
    },
    {
      "id": 4,
      "type": "stat",
      "title": "Chaoskube Status",
      "description": "chaoskube pod running in chaos namespace",
      "datasource": {},
      "gridPos": { "x": 18, "y": 0, "w": 6, "h": 4 },
      "options": {
        "reduceOptions": { "calcs": ["lastNotNull"] },
        "colorMode": "background",
        "graphMode": "none",
        "textMode": "auto"
      },
      "fieldConfig": {
        "defaults": {
          "thresholds": {
            "mode": "absolute",
            "steps": [
              { "color": "red", "value": null },
              { "color": "green", "value": 1 }
            ]
          },
          "mappings": [
            { "options": { "0": { "text": "DOWN" }, "1": { "text": "ACTIVE" } }, "type": "value" }
          ],
          "unit": "short"
        }
      },
      "targets": [
        {
          "expr": "count(kube_pod_status_phase{namespace=\"chaos\", phase=\"Running\"})",
          "legendFormat": "Chaoskube",
          "refId": "A"
        }
      ]
    },
    {
      "id": 5,
      "type": "timeseries",
      "title": "Pod Restart Rate — sre-ai-agent",
      "description": "Rate of container restarts per minute. Spikes = chaoskube kills.",
      "datasource": {},
      "gridPos": { "x": 0, "y": 4, "w": 12, "h": 8 },
      "options": {
        "tooltip": { "mode": "multi" },
        "legend": { "displayMode": "list", "placement": "bottom" }
      },
      "fieldConfig": {
        "defaults": {
          "unit": "short",
          "custom": {
            "lineWidth": 2,
            "fillOpacity": 10,
            "spanNulls": false
          },
          "thresholds": {
            "mode": "absolute",
            "steps": [
              { "color": "green", "value": null },
              { "color": "red", "value": 0.5 }
            ]
          },
          "color": { "mode": "palette-classic" }
        }
      },
      "targets": [
        {
          "expr": "sum by (pod) (rate(kube_pod_container_restarts_total{namespace=\"sre-ai-agent\"}[2m]))",
          "legendFormat": "{{pod}}",
          "refId": "A"
        }
      ]
    },
    {
      "id": 6,
      "type": "timeseries",
      "title": "Pod Phase — sre-ai-agent",
      "description": "Count of pods in each phase. Drops to 1 during chaos kill, recovers to 2.",
      "datasource": {},
      "gridPos": { "x": 12, "y": 4, "w": 12, "h": 8 },
      "options": {
        "tooltip": { "mode": "multi" },
        "legend": { "displayMode": "list", "placement": "bottom" }
      },
      "fieldConfig": {
        "defaults": {
          "unit": "short",
          "custom": {
            "lineWidth": 2,
            "fillOpacity": 10
          },
          "color": { "mode": "palette-classic" }
        }
      },
      "targets": [
        {
          "expr": "count by (phase) (kube_pod_status_phase{namespace=\"sre-ai-agent\"})",
          "legendFormat": "{{phase}}",
          "refId": "A"
        }
      ]
    },
    {
      "id": 7,
      "type": "timeseries",
      "title": "CPU Usage — All Namespaces",
      "description": "CPU cores used per namespace. Agent node will spike during LLM inference.",
      "datasource": {},
      "gridPos": { "x": 0, "y": 12, "w": 12, "h": 8 },
      "options": {
        "tooltip": { "mode": "multi" },
        "legend": { "displayMode": "list", "placement": "bottom" }
      },
      "fieldConfig": {
        "defaults": {
          "unit": "cores",
          "custom": { "lineWidth": 2, "fillOpacity": 10 },
          "color": { "mode": "palette-classic" }
        }
      },
      "targets": [
        {
          "expr": "sum by (namespace) (rate(container_cpu_usage_seconds_total{namespace=~\"sre-ai-agent.*\", container!=\"\"}[2m]))",
          "legendFormat": "{{namespace}}",
          "refId": "A"
        }
      ]
    },
    {
      "id": 8,
      "type": "timeseries",
      "title": "Memory Usage — All Namespaces",
      "description": "Memory bytes used per namespace.",
      "datasource": {},
      "gridPos": { "x": 12, "y": 12, "w": 12, "h": 8 },
      "options": {
        "tooltip": { "mode": "multi" },
        "legend": { "displayMode": "list", "placement": "bottom" }
      },
      "fieldConfig": {
        "defaults": {
          "unit": "bytes",
          "custom": { "lineWidth": 2, "fillOpacity": 10 },
          "color": { "mode": "palette-classic" }
        }
      },
      "targets": [
        {
          "expr": "sum by (namespace) (container_memory_working_set_bytes{namespace=~\"sre-ai-agent.*\", container!=\"\"})",
          "legendFormat": "{{namespace}}",
          "refId": "A"
        }
      ]
    },
    {
      "id": 9,
      "type": "timeseries",
      "title": "HTTP Request Rate — sre-ai-agent app",
      "description": "Requests/sec to the FastAPI app. Should recover quickly after pod kill.",
      "datasource": {},
      "gridPos": { "x": 0, "y": 20, "w": 12, "h": 8 },
      "options": {
        "tooltip": { "mode": "multi" },
        "legend": { "displayMode": "list", "placement": "bottom" }
      },
      "fieldConfig": {
        "defaults": {
          "unit": "reqps",
          "custom": { "lineWidth": 2, "fillOpacity": 10 },
          "color": { "mode": "palette-classic" }
        }
      },
      "targets": [
        {
          "expr": "sum by (handler, method) (rate(http_requests_total{namespace=\"sre-ai-agent\"}[1m]))",
          "legendFormat": "{{method}} {{handler}}",
          "refId": "A"
        }
      ]
    },
    {
      "id": 10,
      "type": "timeseries",
      "title": "HTTP Error Rate — sre-ai-agent app",
      "description": "5xx error rate. Spike during chaos kill, drops once pod recovers.",
      "datasource": {},
      "gridPos": { "x": 12, "y": 20, "w": 12, "h": 8 },
      "options": {
        "tooltip": { "mode": "multi" },
        "legend": { "displayMode": "list", "placement": "bottom" }
      },
      "fieldConfig": {
        "defaults": {
          "unit": "reqps",
          "custom": { "lineWidth": 2, "fillOpacity": 10 },
          "color": { "mode": "palette-classic" },
          "thresholds": {
            "mode": "absolute",
            "steps": [
              { "color": "green", "value": null },
              { "color": "red", "value": 0.1 }
            ]
          }
        }
      },
      "targets": [
        {
          "expr": "sum(rate(http_requests_total{namespace=\"sre-ai-agent\", status=~\"5..\"}[1m]))",
          "legendFormat": "5xx errors/s",
          "refId": "A"
        }
      ]
    },
    {
      "id": 11,
      "type": "logs",
      "title": "Chaoskube Kill Events",
      "description": "Log lines from chaoskube showing which pod was terminated",
      "datasource": { "type": "loki" },
      "gridPos": { "x": 0, "y": 28, "w": 12, "h": 8 },
      "options": {
        "dedupStrategy": "none",
        "enableLogDetails": true,
        "prettifyLogMessage": false,
        "showLabels": false,
        "showTime": true,
        "sortOrder": "Descending",
        "wrapLogMessage": true
      },
      "targets": [
        {
          "expr": "{namespace=\"chaos\"} |= \"terminating\" or {namespace=\"chaos\"} |= \"killed\" or {namespace=\"chaos\"} |= \"deleted\"",
          "refId": "A"
        }
      ]
    },
    {
      "id": 12,
      "type": "logs",
      "title": "LangGraph RCA Output",
      "description": "RCA analysis produced by the agent after each chaos-triggered alert",
      "datasource": { "type": "loki" },
      "gridPos": { "x": 12, "y": 28, "w": 12, "h": 8 },
      "options": {
        "dedupStrategy": "none",
        "enableLogDetails": true,
        "prettifyLogMessage": false,
        "showLabels": false,
        "showTime": true,
        "sortOrder": "Descending",
        "wrapLogMessage": true
      },
      "targets": [
        {
          "expr": "{namespace=\"sre-ai-agent-llm\"} |= \"RCA\" or {namespace=\"sre-ai-agent-llm\"} |= \"root_cause\" or {namespace=\"sre-ai-agent-llm\"} |= \"triage\"",
          "refId": "A"
        }
      ]
    },
    {
      "id": 13,
      "type": "logs",
      "title": "Agent Error Logs",
      "description": "ERROR-level logs from the LangGraph agent",
      "datasource": { "type": "loki" },
      "gridPos": { "x": 0, "y": 36, "w": 24, "h": 6 },
      "options": {
        "dedupStrategy": "none",
        "enableLogDetails": true,
        "prettifyLogMessage": false,
        "showLabels": true,
        "showTime": true,
        "sortOrder": "Descending",
        "wrapLogMessage": true
      },
      "targets": [
        {
          "expr": "{namespace=~\"sre-ai-agent.*\"} |= \"ERROR\"",
          "refId": "A"
        }
      ]
    }
  ]
}